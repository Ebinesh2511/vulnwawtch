# Copy to .env and fill in. .env is git-ignored.

GITHUB_ORG=guvi-geek

# GitHub access. Set these to use a GitHub App (recommended on a server). Leave them empty to fall back to
# GH_TOKEN from the environment, or to the local `gh auth login` on a developer laptop.
GITHUB_APP_ID=
# Optional: normally saved automatically by the install flow (or looked up from GITHUB_ORG)
GITHUB_APP_INSTALLATION_ID=
# The App's private key: a path to the .pem, or the PEM text itself (newlines may be written as \n)
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
# Optional: the App's slug for the install link (read from GitHub when empty)
GITHUB_APP_SLUG=
# Webhook secret: the same value as in the App's webhook settings. /github/webhook refuses calls without it.
GITHUB_WEBHOOK_SECRET=
DASHBOARD_URL=http://127.0.0.1:8000

# Gemini: key comes from your shell (GEMINI_API_KEY) or set it here
# GEMINI_API_KEY=
GEMINI_TRIAGE_MODEL=gemini-3.5-flash,gemini-2.5-flash
GEMINI_GUIDE_MODEL=gemini-pro-latest,gemini-3.5-flash

# Pipeline
FEED_DAYS=3
RECENT_DAYS=30
MIN_SEVERITY=HIGH
INTERVAL_MIN=30
SCHEDULER=on
AI_MAX_PER_RUN=10

# Mail: dry_run keeps mails in the dashboard only. Set to send once SMTP works.
MAIL_MODE=dry_run
# Gmail: SMTP_PASS must be an App Password (needs 2-Step Verification), not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=sender@gmail.com
# starttls for port 587, ssl for port 465
SMTP_TLS=starttls

# Auto-fix: off | dry_run (branch + diff locally, nothing pushed) | pr (push branch + open PR)
AUTOFIX_MODE=dry_run
AUTOFIX_MAX_PER_RUN=5
# Open PRs as drafts (true) or ready for review (false)
AUTOFIX_PR_DRAFT=true
# Hard fixes at this priority or more urgent get an escalation mail (0 = P0 only, 1 = P0 + P1)
ESCALATE_MAX_PRIORITY=1
